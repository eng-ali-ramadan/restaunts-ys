@model RestaurantSystem.Models.Payment

@{
    ViewData["Title"] = "Payment Details";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card shadow-sm border-0 rounded-4 p-4 bg-light">
        <div class="text-center mb-4">
            <div class="bg-success text-white p-3 rounded-circle d-inline-block mb-2 shadow-sm">
                <i class="bi bi-check-lg fs-1"></i>
            </div>
            <h2 class="fw-bold text-dark">Payment Successful</h2>
            <p class="text-muted">Here are the details of your transaction</p>
        </div>

        <ul class="list-group list-group-flush rounded-3 mb-4 shadow-sm">
            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold text-muted">Payment ID:</span>
                <span class="fw-bold">#@Model.PaymentId</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold text-muted">Order ID:</span>
                <span class="fw-bold">#@Model.OrderId</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold text-muted">Amount Paid:</span>
                <span class="fw-bold text-success fs-5">@Model.Amount.ToString("C")</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold text-muted">Payment Method:</span>
                <span class="badge bg-secondary">@Model.PaymentMethod</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold text-muted">Status:</span>
                <span class="badge bg-success">@Model.Status</span>
            </li>
            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                <span class="fw-semibold text-muted">Payment Date:</span>
                <span>@Model.PaymentDate.ToString("g")</span>
            </li>
        </ul>

        <div class="text-center">
            <a asp-controller="Menu" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                <i class="bi bi-house-door me-2"></i> Back to Home / Menu
            </a>
        </div>
    </div>
</div>